# One Discord application/token runs BOTH OctoTracker and OctoCop features.
DISCORD_TOKEN=PASTE_OCTOBOT_TOKEN_HERE

# OctoWoW Fan Discord
DISCORD_GUILD_ID=1547014756463026197

# Tracker channels
DISCORD_STATUS_CHANNEL_ID=1547281778841100388
DISCORD_ALERT_CHANNEL_ID=1547281778841100388
DISCORD_ANNOUNCEMENT_CHANNEL_ID=1547025378479181895

# Tracker polling / connectivity
OCTOWOW_REALMLIST_HOST=play.octowow.st
OCTOWOW_AUTH_PORT=3724
STATUS_POLL_SECONDS=10
ANNOUNCEMENT_POLL_SECONDS=60
AUTH_PROBE_TIMEOUT_SECONDS=5
AUTH_FAILURE_CONFIRMATIONS=3
AUTH_RECOVERY_CONFIRMATIONS=2
REPORT_ACTIVE_MINUTES=10
REPORT_DEGRADED_THRESHOLD=3

# Booty Bay Pirate Radio
RADIO_ENABLED=true
RADIO_BASE_URL=https://radio.octowow.st
RADIO_STATION_SHORTCODE=booty_bay_pirate_radio
DISCORD_RADIO_CHANNEL_ID=1547109894732120104
DISCORD_RADIO_PING_ROLE_ID=1547108101747118100
RADIO_POLL_SECONDS=10
RADIO_GO_LIVE_CONFIRMATIONS=2
# Scheduled shows are pinged at their scheduled start time. Set true to also ping
# whenever a DJ connects live (unscheduled streams); off by default.
RADIO_LIVE_ALERTS=false
# Days of schedule shown by /nextshows and /radio (recurring shows repeat inside it)
RADIO_SCHEDULE_DAYS=14
# DJ Twitch links shown in the ping (only the live DJ's link is used). Built-in:
# Whiski, Mossa, Tekeela, Sabellwind. Override or extend with "Name=url,Name=url".
#RADIO_DJ_STREAMS=Whiski=https://www.twitch.tv/djwhiski,Mossa=https://www.twitch.tv/dj_mossa

# Moderation logs + staff role defaults
DISCORD_LOG_CHANNEL_ID=1547053413899051038
DISCORD_HELPER_ROLE_ID=1547031604113707028
DISCORD_MODERATOR_ROLE_ID=1547031685944713307
DISCORD_ADMIN_ROLE_ID=1547031493262573668

# /authcheck is open to everyone but only in this channel (default shown; empty = anywhere)
#DISCORD_AUTHCHECK_CHANNEL_ID=1547064843909988433

# Legacy-role cleanup (defaults shown). Members lose the REMOVE role as soon as they
# gain a trigger role. Requires the Server Members Intent in the Discord Developer Portal.
#ROLE_CLEANUP_REMOVE_ROLE_ID=1547037223558451291
#ROLE_CLEANUP_AUTO_TRIGGER_ROLE_IDS=1547371277474603028

# Shared SQLite database for BOTH systems
DATABASE_PATH=data/octobot.db
